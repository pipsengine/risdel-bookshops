# Application
APP_NAME=Risdel Books
APP_URL=http://localhost:3000
APP_VERSION=0.2.0
NODE_ENV=development
AUTH_SECRET=replace-with-at-least-32-random-characters
SESSION_HOURS=8

# Persistence provider: google-sheets | sql-server | postgresql
DATA_PROVIDER=google-sheets

# Initial bootstrap administrator (also used to seed Auth_Users)
BOOTSTRAP_ADMIN_EMAIL=admin@risdel.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe@123
BOOTSTRAP_ADMIN_NAME=System Administrator

# Google Sheets (required when DATA_PROVIDER=google-sheets)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_CACHE_TTL_SECONDS=30

# SQL Server (used when DATA_PROVIDER=sql-server; preserved for future migration)
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=RisdelBooks_Dev
DB_USER=risdel_app
DB_PASSWORD=change-this-password
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT=15000
DB_REQUEST_TIMEOUT=30000

# Storage
FILE_STORAGE_PATH=./data/uploads
MAX_UPLOAD_MB=10
LOG_LEVEL=info

# Feature flags
ENABLE_POS=false
ENABLE_ACADEMIC=false
ENABLE_ECOMMERCE=false
