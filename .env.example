# Application
APP_NAME=Risdel Bookshops
APP_URL=http://localhost:3000
APP_VERSION=0.36.2
NODE_ENV=development
AUTH_SECRET=replace-with-at-least-32-random-characters
SESSION_HOURS=8

# Initial bootstrap administrator - change immediately in production
BOOTSTRAP_ADMIN_EMAIL=admin@risdel.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe@123
BOOTSTRAP_ADMIN_NAME=System Administrator

# Active persistence provider: google-sheets | sql-server
DATA_PROVIDER=google-sheets

# Google Sheets provider (Spreadsheet ID is safe to store; credentials are secrets)
GOOGLE_SHEETS_SPREADSHEET_ID=1P1gFMGXcCWdxbPaNH24BHk9-NW_yqFqydj16QyGYIQw
GOOGLE_SERVICE_ACCOUNT_EMAIL=replace-with-service-account@project-id.iam.gserviceaccount.com
# Prefer BASE64 on Vercel:
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_BASE64=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_CACHE_TTL_SECONDS=30

# SQL Server provider - preserved for future switching/migration
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=RisdelBooks_Dev
DB_USER=risdel_app
DB_PASSWORD=change-this-password
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT=15000
DB_REQUEST_TIMEOUT=30000

# Storage
FILE_STORAGE_PATH=./data/uploads
MAX_UPLOAD_MB=10
LOG_LEVEL=info

# Feature flags
ENABLE_POS=true
ENABLE_ACADEMIC=true
ENABLE_ECOMMERCE=false

# Security controls
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
REMEMBER_SESSION_HOURS=168

# Module 35 — Online Store
COMMERCE_DEFAULT_DELIVERY_FEE=0
